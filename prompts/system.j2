## STEP 1 — Create Toolkit

Run this command first, before any search or grep:

```bash
cat << 'TOOLEOF' > /app/toolkit.py
import sys,json,math
def percent_change(a):
    o,n=float(a['old']),float(a['new']);r=(n-o)/o*100
    return abs(r) if a.get('absolute',True) else r
def percent_difference(a):
    x,y=float(a['a']),float(a['b']);return abs(x-y)/((x+y)/2)*100
def arithmetic_mean(a):
    v=[float(x) for x in a['values']];return sum(v)/len(v)
def cagr(a):
    return((float(a['end_val'])/float(a['start_val']))**(1.0/float(a['periods']))-1)*100
def abs_diff(a):
    return abs(float(a['a'])-float(a['b']))
def theil_index(a):
    v=[float(x) for x in a['values']];n=len(v);mu=sum(v)/n
    return sum((x/mu)*math.log(x/mu) for x in v)/n
def hp_filter(a):
    y=[float(x) for x in a['y']];lam=float(a.get('lamb',100));n=len(y)
    if n<3:return{'trend':y[:],'cycle':[0.0]*n}
    H=[[0.0]*n for _ in range(n)]
    for k in range(n-2):
        idx=[k,k+1,k+2];val=[1.0,-2.0,1.0]
        for i in range(3):
            for j in range(3):H[idx[i]][idx[j]]+=lam*val[i]*val[j]
    for i in range(n):H[i][i]+=1.0
    A=[H[i][:]+[y[i]] for i in range(n)]
    for c in range(n):
        mr=c;mv=abs(A[c][c])
        for r in range(c+1,n):
            if abs(A[r][c])>mv:mv=abs(A[r][c]);mr=r
        if mr!=c:A[c],A[mr]=A[mr],A[c]
        p=A[c][c]
        if abs(p)<1e-15:continue
        for r in range(c+1,n):
            f=A[r][c]/p
            for j in range(c,n+1):A[r][j]-=f*A[c][j]
    t=[0.0]*n
    for i in range(n-1,-1,-1):
        s=A[i][n]
        for j in range(i+1,n):s-=A[i][j]*t[j]
        t[i]=s/A[i][i]
    return{'trend':t,'cycle':[y[i]-t[i] for i in range(n)]}
def geometric_mean(a):
    v=[float(x) for x in a['values']];return math.exp(sum(math.log(x) for x in v)/len(v))
def annualized_volatility(a):
    r=[float(x) for x in a['rates']];p=float(a.get('periods_per_year',52))
    if len(r)<2:return 0.0
    lr=[math.log(r[i+1]/r[i]) for i in range(len(r)-1)]
    return math.sqrt(sum(x**2 for x in lr)/len(lr)*p)*100
def count_local_maxima(a):
    s=[float(x) for x in a['series']];return sum(1 for i in range(1,len(s)-1) if s[i]>s[i-1] and s[i]>s[i+1])
def count_local_minima(a):
    s=[float(x) for x in a['series']];return sum(1 for i in range(1,len(s)-1) if s[i]<s[i-1] and s[i]<s[i+1])
def euclidean_norm(a):
    v=[float(x) for x in a['vector']];return math.sqrt(sum(x**2 for x in v))
def parse_table(a):
    lines=[l.strip() for l in a['text'].strip().split('\n') if l.strip()]
    dl=[]
    for l in lines:
        if not l.replace('|','').replace('-','').replace(' ','').replace(':',''):continue
        dl.append(l)
    if len(dl)<2:return[]
    h=[c.strip() for c in dl[0].split('|') if c.strip()]
    return[dict(zip(h,[c.strip() for c in r.split('|') if c.strip()][:len(h)])) for r in dl[1:] if len([c.strip() for c in r.split('|') if c.strip()])>=len(h)]
def std_dev(a):
    v=[float(x) for x in a['values']];mu=sum(v)/len(v);ddof=0 if a.get('population',True) else 1
    return math.sqrt(sum((x-mu)**2 for x in v)/(len(v)-ddof))
def coefficient_of_variation(a):
    v=[float(x) for x in a['values']];mu=sum(v)/len(v)
    return math.sqrt(sum((x-mu)**2 for x in v)/len(v))/abs(mu)*100
def linear_regression(a):
    y=[float(v) for v in a['y']];n=len(y);x=[float(v) for v in a.get('x',list(range(n)))]
    mx=sum(x)/n;my=sum(y)/n;sx2=sum((xi-mx)**2 for xi in x)
    b=sum((xi-mx)*(yi-my) for xi,yi in zip(x,y))/sx2;c=my-b*mx
    yh=[b*xi+c for xi in x];ss_res=sum((yi-yhi)**2 for yi,yhi in zip(y,yh))
    ss_tot=sum((yi-my)**2 for yi in y);r2=1-ss_res/ss_tot if ss_tot else 1.0
    res={'slope':b,'intercept':c,'r_squared':r2}
    if 'predict_x' in a:res['prediction']=b*float(a['predict_x'])+c
    return res
def polynomial_regression(a):
    y=[float(v) for v in a['y']];n=len(y);x=[float(v) for v in a.get('x',list(range(n)))];d=int(a.get('degree',2));nc=d+1
    XtX=[[sum(xi**(i+j) for xi in x) for j in range(nc)] for i in range(nc)]
    Xty=[sum(yi*xi**i for xi,yi in zip(x,y)) for i in range(nc)]
    A=[XtX[i][:]+[Xty[i]] for i in range(nc)]
    for c in range(nc):
        mr=c;mv=abs(A[c][c])
        for r in range(c+1,nc):
            if abs(A[r][c])>mv:mv=abs(A[r][c]);mr=r
        if mr!=c:A[c],A[mr]=A[mr],A[c]
        p=A[c][c]
        if abs(p)<1e-15:continue
        for r in range(c+1,nc):
            f=A[r][c]/p
            for j in range(c,nc+1):A[r][j]-=f*A[c][j]
    coeffs=[0.0]*nc
    for i in range(nc-1,-1,-1):
        s=A[i][nc]
        for j in range(i+1,nc):s-=A[i][j]*coeffs[j]
        if abs(A[i][i])>1e-15:coeffs[i]=s/A[i][i]
    yh=[sum(coeffs[i]*xi**i for i in range(nc)) for xi in x];my=sum(y)/n
    ss_res=sum((yi-yhi)**2 for yi,yhi in zip(y,yh));ss_tot=sum((yi-my)**2 for yi in y)
    r2=1-ss_res/ss_tot if ss_tot else 1.0
    res={'coefficients':coeffs,'r_squared':r2}
    if 'predict_x' in a:px=float(a['predict_x']);res['prediction']=sum(coeffs[i]*px**i for i in range(nc))
    return res
def exponential_smoothing(a):
    v=[float(x) for x in a['values']];alpha=float(a.get('alpha',0.4));s=[v[0]]
    for vi in v[1:]:s.append(alpha*vi+(1-alpha)*s[-1])
    fp=int(a.get('forecast_periods',0))
    for _ in range(fp):s.append(s[-1])
    return{'smoothed':s,'forecast':s[-1]}
def moving_average(a):
    v=[float(x) for x in a['values']];w=int(a.get('window',3));centered=a.get('centered',False)
    if centered:
        h=w//2;return[sum(v[max(0,i-h):min(len(v),i+h+1)])/len(v[max(0,i-h):min(len(v),i+h+1)]) for i in range(len(v))]
    return[sum(v[i:i+w])/w for i in range(len(v)-w+1)]
def range_stat(a):
    v=[float(x) for x in a['values']];return max(v)-min(v)
C={'percent_change':percent_change,'percent_difference':percent_difference,'arithmetic_mean':arithmetic_mean,'cagr':cagr,'abs_diff':abs_diff,'theil_index':theil_index,'hp_filter':hp_filter,'geometric_mean':geometric_mean,'annualized_volatility':annualized_volatility,'count_local_maxima':count_local_maxima,'count_local_minima':count_local_minima,'euclidean_norm':euclidean_norm,'parse_table':parse_table,'std_dev':std_dev,'coefficient_of_variation':coefficient_of_variation,'linear_regression':linear_regression,'polynomial_regression':polynomial_regression,'exponential_smoothing':exponential_smoothing,'moving_average':moving_average,'range_stat':range_stat}
if __name__=='__main__':
    r=C[sys.argv[1]](json.loads(sys.argv[2]))
    print(json.dumps(r) if isinstance(r,(dict,list)) else r)
TOOLEOF
```

